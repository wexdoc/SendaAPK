<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:PulseAPK.Core.ViewModels;assembly=PulseAPK.Core"
 xmlns:services="clr-namespace:PulseAPK.Core.Services;assembly=PulseAPK.Core"
 x:Class="PulseAPK.Avalonia.Views.LocalApkView" x:DataType="vm:LocalApkViewModel">
 <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12" Margin="20">
  <StackPanel Spacing="5">
   <TextBlock Text="Analizar APK · Local y privado" Classes="page-title" />
   <TextBlock Text="Selecciona un archivo. No se instala ni se ejecuta; no se sube a servicios externos." TextWrapping="Wrap" />
  </StackPanel>
  <Border Grid.Row="1" Classes="card">
   <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
    <TextBox Text="{Binding ApkPath}" Watermark="Ruta del archivo .apk" IsEnabled="{Binding !Busy}" VerticalAlignment="Center" />
    <Button Grid.Column="1" Content="Seleccionar APK" Command="{Binding BrowseCommand}" />
    <Button Grid.Column="2" Content="Analizar" Command="{Binding AnalyseCommand}" Classes="primary-action" />
    <Button Grid.Column="3" Content="Cancelar" Command="{Binding CancelCommand}" />
   </Grid>
  </Border>
  <StackPanel Grid.Row="2" Spacing="7">
   <CheckBox Content="Análisis amplio: incluir bibliotecas (más lento y con más coincidencias legítimas)" IsChecked="{Binding IncludeLibraries}" IsEnabled="{Binding !Busy}" />
   <ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}" Height="4" />
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
   <TextBlock Text="{Binding DefenderSummary}" FontWeight="Bold" TextWrapping="Wrap" />
   <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
  </StackPanel>
  <TabControl Grid.Row="3">
   <TabItem Header="Hallazgos">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
     <TextBox Text="{Binding FindingQuery}" Watermark="Filtrar por permiso, categoría, archivo o evidencia" />
     <TextBlock Grid.Row="1" Text="{Binding FindingCount}" TextWrapping="Wrap" />
     <ListBox Grid.Row="2" ItemsSource="{Binding VisibleFindings}">
      <ListBox.ItemTemplate>
       <DataTemplate x:DataType="services:CodeEvidence">
        <StackPanel Spacing="4" Margin="6" MaxWidth="820">
         <TextBlock Text="{Binding Category}" FontWeight="Bold" />
         <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" />
         <TextBlock Text="{Binding Location}" TextWrapping="Wrap" FontSize="12" />
         <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
        </StackPanel>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </TabItem>
   <TabItem Header="Resultados e informe">
    <TextBox Text="{Binding ResultText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" ScrollViewer.VerticalScrollBarVisibility="Auto" />
   </TabItem>
   <TabItem Header="Cuarentena">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Margin="10">
     <TextBlock Text="Cuarentena reversible: no elimina virus del interior del APK ni limpia dispositivos Android." TextWrapping="Wrap" />
     <ListBox Grid.Row="1" ItemsSource="{Binding QuarantineEntries}" SelectedItem="{Binding SelectedEntry}" />
     <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
      <Button Content="Actualizar lista" Command="{Binding RefreshQuarantineCommand}" />
      <Button Content="Restaurar seleccionado" Command="{Binding RestoreCommand}" />
     </StackPanel>
    </Grid>
   </TabItem>
  </TabControl>
  <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10">
   <Button Content="Guardar TXT y JSON" Command="{Binding SaveCommand}" />
   <Button Content="Poner APK en cuarentena" Command="{Binding IsolateCommand}" />
   <Button Content="Borrar datos generados" Command="{Binding CleanCommand}" />
  </StackPanel>
 </Grid>
</UserControl>
